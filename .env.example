CLASSIFICATION_CONFIDENCE_THRESHOLD=0.3
CHUNK_SIZE=700
CHUNK_OVERLAP=100
TOP_K_CHUNKS=4

# Frontend Configuration
VITE_API_BASE_URL="http://127.0.0.1:8000"

